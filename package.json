{
  "name": "claudoist-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @gtd/desktop dev",
    "build": "pnpm --recursive --if-present build",
    "dist": "pnpm --filter @gtd/desktop dist",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "smoke": "pnpm --filter @gtd/desktop dev -- --dump=views",
    "seed": "pnpm --filter @gtd/storage-sqlite seed",
    "cli": "tsx packages/cli/src/main.ts",
    "check-prompt": "node apps/desktop/scripts/check-prompt-sync.mjs",
    "agent-smoke": "pnpm --filter @gtd/desktop dev -- --agent-smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "license": "Unlicense"
}
